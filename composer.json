{
    "name": "publishpress/stripe-php",
    "version": "20.3.1.1",
    "type": "library",
    "description": "Stripe PHP Library, prefixed for PublishPress",
    "keywords": [
        "stripe",
        "payment processing",
        "api",
        "publishpress"
    ],
    "homepage": "https://stripe.com/",
    "license": "MIT",
    "authors": [
        {
            "name": "Stripe and contributors",
            "homepage": "https://github.com/stripe/stripe-php/contributors"
        },
        {
            "name": "PublishPress",
            "email": "help@publishpress.com"
        }
    ],
    "autoload": {
        "files": [
            "lib/include.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Helper\\": "tests/_support/Helper/"
        }
    },
    "require": {
        "php": ">=7.4.0",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-mbstring": "*"
    },
    "require-dev": {
        "stripe/stripe-php": "20.3.1",
        "brianhenryie/strauss": "0.29.2",
        "publishpress/version-loader-generator": "^1.0",
        "publishpress/dev-workspace": "^1.8"
    },
    "extra": {
        "plugin-name": "library-stripe-php",
        "plugin-slug": "library-stripe-php",
        "plugin-folder": "library-stripe-php",
        "plugin-lang-domain": "stripe-php",
        "plugin-github-repo": "publishpress/library-stripe-php",
        "plugin-composer-package": "publishpress/stripe-php",
        "generator": {
            "lib-class-test": "class_exists('PublishPress\\Stripe\\StripeClient', false)",
            "action-register-priority": "-200",
            "action-initialize-priority": "-185"
        },
        "strauss": {
            "target_directory": "lib",
            "namespace_prefix": "PublishPress\\",
            "classmap_prefix": "PublishPress_",
            "constant_prefix": "PUBLISHPRESS_",
            "include_author": true,
            "classmap_output": true,
            "packages": [
                "stripe/stripe-php"
            ],
            "delete_vendor_packages": true,
            "delete_vendor_files": true
        }
    },
    "scripts": {
        "strauss": [
            "vendor/bin/strauss"
        ],
        "generate-files": [
            "php scripts/post-update.php",
            "vendor/bin/version-loader-generator",
            "php tests/bin/guard-generated-include.php",
            "php tests/bin/patch-version-loader-cest.php"
        ],
        "post-install-cmd": [
            "@strauss",
            "@generate-files"
        ],
        "post-update-cmd": [
            "@strauss",
            "@generate-files"
        ],
        "test:unit": "vendor/bin/codecept run Unit",
        "test:integration": [
            "bash tests/bin/fix-linux-test-volume-perms.sh",
            "vendor/bin/codecept run Integration"
        ],
        "test:all": [
            "@test:unit",
            "@test:integration"
        ]
    },
    "config": {
        "allow-plugins": {
            "publishpress/dev-workspace": true,
            "composer/installers": true,
            "php-http/discovery": true,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "phpstan/extension-installer": true
        }
    }
}
