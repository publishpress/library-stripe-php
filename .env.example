#
# Package identity (see publishpress/dev-workspace README: keep keys aligned with composer.json extra)
#
PLUGIN_NAME="library-stripe-php"
PLUGIN_TYPE="LIBRARY"
PLUGIN_COMPOSER_PACKAGE="publishpress/stripe-php"
PLUGIN_SLUG="library-stripe-php"

#
# Git / GitHub (optional; set token for releases/API; leave name/email empty to be prompted)
#
GITHUB_ACCESS_TOKEN="ghp_0000000000000000000000000000000000000000"
GIT_USER_NAME=""
GIT_USER_EMAIL=""

#
# Docker (shared image tags — use the same values across all PublishPress plugins)
#
CONTAINER_NAME="library-stripe-php"
TERMINAL_IMAGE_NAME="publishpress/dev-workspace-terminal:node-25"
WP_IMAGE_NAME="publishpress/dev-workspace-wordpress:wordpress-7.1-php-8.5"
WPCLI_IMAGE_NAME="publishpress/dev-workspace-wpcli:wpcli-2-php-8.5"

#
# Local cache (relative to package root unless absolute)
#
CACHE_PATH="./dev-workspace-cache"

#
# Docker Compose --env-file interpolates compose.yaml from this file, not the
# shell. `composer test:up` writes REPO_ROOT, DEV_WORKSPACE_REAL, and an
# absolute CACHE_PATH here. If you copy .env.example by hand, set them to
# this checkout or the first test:up will fail with "REPO_ROOT is not set".
#

#
# WordPress / Codeception test paths
#
# Relative to the directory that contains codeception.yml, or absolute.
WP_TESTS_ROOT_DIR="dev-workspace-cache/wp_test"

# Database: mysql://user:pass@host:port/db — tests must not point at production data.
WP_TESTS_DB_URL="mysql://root:root@127.0.0.1:3351/wordpress"
WP_TESTS_DB_NAME="wordpress"
WP_TESTS_DB_HOST="127.0.0.1:3351"
WP_TESTS_DB_USER="root"
WP_TESTS_DB_PASSWORD="root"

WP_TESTS_TEST_TABLE_PREFIX="wp_"
WP_TESTS_TABLE_PREFIX="wp_"

#
# Published ports (change if they conflict with other containers)
#
WP_TESTS_HTTP_PORT="8051"
DB_TESTS_PORT="3351"
MAILHOG_WEB_PORT="8053"
MAILHOG_SMTP_PORT="8054"

#
# End-to-end / integration site
#
WP_TESTS_URL="http://localhost:8051"
WP_TESTS_DOMAIN="localhost:8051"
WP_TESTS_ADMIN_PATH="/wp-admin"
WP_TESTS_ADMIN_USER="admin"
WP_TESTS_ADMIN_PASSWORD="admin"

#
# Translations (required by publishpress/dev-workspace env-bootstrap)
#
LANG_LOCALES="ar cs_CZ da_DK de_DE el es_ES fa_IR fi fil fr_FR he_IL hu_HU id_ID it_IT ja ko_KR nl_NL pl_PL pt_BR pt_PT ro_RO ru_RU sv_SE th tr_TR vi yor zh_CN"
LANG_DOMAIN="stripe-php"
LANG_DIR="languages"
GENERATE_TRANSLATION_JSON="0"
